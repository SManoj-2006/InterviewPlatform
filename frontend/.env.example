# Copy this file to `.env` and fill in the values.
# NEVER commit the real `.env` file.

# Backend API base URL (no trailing slash).
# Optional: when omitted the app uses same-origin "/api", which is what the
# production Docker image does (backend serves the frontend itself).
VITE_API_URL=http://localhost:3000/api

# Clerk publishable key (https://dashboard.clerk.com)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Stream API key (https://dashboard.getstream.io)
VITE_STREAM_API_KEY=
