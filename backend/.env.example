# Copy this file to `.env` and fill in the values.
# NEVER commit the real `.env` file.

# Server
PORT=3000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB connection string (local docker-compose uses mongodb://localhost:27018/devintervue)
DB_URL=mongodb://localhost:27018/devintervue

# Clerk (https://dashboard.clerk.com) — required for auth
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...

# Inngest (https://www.inngest.com) — required for Clerk webhook user sync
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Stream (https://dashboard.getstream.io) — required for video + chat
STREAM_API_KEY=
STREAM_API_SECRET=

# Code execution backend: "piston" or "wandbox".
# - piston: self-hosted Piston (recommended, see docker-compose.yml) or the
#   hosted Piston API (requires PISTON_AUTH_TOKEN; public API is whitelist-only
#   since Feb 2026, so this only works with your own instance or a token).
# - wandbox: free, no key needed. This is the default when PISTON_API_URL is
#   not set, so zero-config deploys (e.g. Render) get working code execution.
CODE_EXECUTOR=wandbox
PISTON_API_URL=http://localhost:2000/api/v2
PISTON_AUTH_TOKEN=
